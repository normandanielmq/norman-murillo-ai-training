{
  "name": "norman-murillo-ai-training",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend"],
  "scripts": {
    "setup:backend": "node scripts/setup-backend.mjs",
    "dev:all": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"wait-on -t 120000 http-get://127.0.0.1:8000/health && npm run dev\"",
    "dev:backend": "node scripts/dev-backend.mjs",
    "dev": "npm run dev --workspace=frontend",
    "dev:fast": "npm run dev:fast --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "test": "npm run test --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.5"
  }
}
